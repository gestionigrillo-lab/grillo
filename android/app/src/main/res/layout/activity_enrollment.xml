<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_background"
    android:padding="32dp">

    <TextView
        android:id="@+id/enrollTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enroll_device"
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/deviceModelLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modello:"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/enrollTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/deviceModelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@id/deviceModelLabel"
        app:layout_constraintStart_toEndOf="@id/deviceModelLabel" />

    <TextView
        android:id="@+id/androidVersionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Android:"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/deviceModelLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/androidVersionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@id/androidVersionLabel"
        app:layout_constraintStart_toEndOf="@id/androidVersionLabel" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/enroll_device"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/androidVersionLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
